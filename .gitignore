.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/

# OS
*.swp
*.swo

# scratch / temp — extraction artifacts, local blueprints, PATs, etc.
/tmp/
/extracted.txt
*.docx.bak

# Claude Code — the whole .claude/ dir is per-machine session state,
# skills packages, worktrees etc. Nothing there is portable across
# developers, so keep it local.
.claude/
.claude-worktrees/

# Pre-installed Claude Code skills packages (roughly ~36 skills) —
# machine-local development assets, not part of the site.
.agents/
skills-lock.json

# MCP server config is machine-local
.mcp.json

# Client-supplied brief — don't commit to a public repo by default.
# Delete this line if you'd like to include it as project documentation.
/Lakspire_Complete_Website_Blueprint.docx

# Internal design docs — playbook lives locally; not part of the public
# repo. Same rationale as the client brief above.
/docs/

# Local screenshots + Playwright MCP scratch — dev-only artifacts
/screenshots/
/.playwright-mcp/
/chk-*.png
/story-*.png
/ops-*.png
/*.debug.png
CHANGES.pdf
