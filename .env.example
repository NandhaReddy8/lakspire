# ─────────────────────────────────────────────────────────────
#  Environment variables required for the Lakspire site
# ─────────────────────────────────────────────────────────────
#
#  Copy this file to `.env.local` and fill each value in.
#  Never commit `.env` or `.env.local` — see .gitignore.

# Resend (transactional email)
# Get from: https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here

# Cloudflare Turnstile (bot/form CAPTCHA)
# Get from: Cloudflare Dashboard → Turnstile → Add site → lakspireai.com
# Site key is public and safe to expose (NEXT_PUBLIC_ prefix).
# Secret key must stay server-side.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAAxxxxxxxxxxxxxxxx
TURNSTILE_SECRET_KEY=0x4AAAAAAAxxxxxxxxxxxxxxxxxxxxxxxx

# Mail routing (used by /api/notify)
# FROM must be an address on a domain verified in Resend.
# TO is the mailbox that receives notifications (Workspace inbox).
MAIL_FROM="Lakspire <notifications@lakspireai.com>"
MAIL_TO=hello@lakspire.com

# Public site URL (used in email templates for absolute links).
NEXT_PUBLIC_SITE_URL=https://lakspireai.com
